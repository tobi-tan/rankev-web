# Production build (Vite đọc khi chạy `vite build` / trên Vercel).
# LƯU Ý: stack là Vite → biến phải bắt đầu bằng VITE_ (không phải REACT_APP_).
# Backend đã chuyển Railway→Render (2026-09-12). URL Railway cũ đã CHẾT — dùng Render.
VITE_API_URL=https://rankev-backend.onrender.com
# Google OAuth Client ID loại WEB — công khai (vốn nằm trong bundle web). Cần có ở đây để bản
# APK/AAB build trên GitHub Actions cũng có nút Google (đăng nhập native dùng chính ID này).
VITE_GOOGLE_CLIENT_ID=990057326052-smmut7jifbn7mqns1k55lnaahtqf5bbr.apps.googleusercontent.com
